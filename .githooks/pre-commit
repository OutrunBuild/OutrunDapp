#!/usr/bin/env bash
# Fast gate: runs prettier --check and eslint against staged blobs (git show :file, not the worktree
# version). Checks the staged content itself -- a mismatch between staged and worktree (worktree
# changed/reformatted after staging) produces neither false blocks nor false passes.
# prettier domain = staged ∩ not in .prettierignore: components/fixtures/docs are outside the domain
# per the repo's byte-freeze-first policy for those trees; they are skipped and the list is announced.
# eslint uses --stdin --stdin-filename; the filename must be repo-relative (absolute paths cannot find
# the flat config).
# Only staged content is checked -- parallel sessions and unstaged changes must not fail this commit
# (same .githooks convention as Memeverse/OutStake).
# Mount: git config core.hooksPath .githooks (already set in this repo's .git/config; the global
# ~/.gitconfig also points at the same path).
# Heavy gates (typecheck + full vitest, which includes the fixture-boundary gate and the four
# design/CJK checkers) run in pre-push; emergency bypass = git commit
# --no-verify, then re-run afterwards:
#   pnpm typecheck && pnpm lint && pnpm format:check && pnpm test \
#     && pnpm check:design && pnpm check:contrast && pnpm check:cjk-font \
#     && node scripts/check-architecture-compliance.mjs
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

skipped=()
eslint_targets=()
for f in "${staged[@]}"; do
  in_prettier_domain=0 in_eslint_domain=0
  case "$f" in
    *.ts|*.tsx|*.js|*.jsx|*.mts|*.cts|*.mjs|*.cjs|*.json|*.css|*.md|*.yml|*.yaml) in_prettier_domain=1 ;;
  esac
  case "$f" in
    *.ts|*.tsx|*.js|*.jsx|*.mts|*.cts|*.mjs|*.cjs) in_eslint_domain=1 ;;
  esac
  if [ "$in_prettier_domain" = 0 ] && [ "$in_eslint_domain" = 0 ]; then
    continue
  fi

  if [ "$in_prettier_domain" = 1 ]; then
    if pnpm exec prettier --file-info "$f" | grep -q '"ignored"[[:space:]]*:[[:space:]]*true'; then
      skipped+=("$f")
    elif ! git show :"$f" | pnpm exec prettier --check --stdin-filepath "$f"; then
      echo "pre-commit: staged content failed prettier: $f (format it, then git add again)" >&2
      exit 1
    fi
  fi

  if [ "$in_eslint_domain" = 1 ]; then
    eslint_targets+=("$f")
  fi
done

if [ "${#skipped[@]}" -gt 0 ]; then
  echo "pre-commit: skipped outside the prettier domain (.prettierignore byte-freeze ruling): ${skipped[*]}" >&2
fi

for f in "${eslint_targets[@]}"; do
  if ! git show :"$f" | pnpm exec eslint --stdin --stdin-filename "$f"; then
    echo "pre-commit: staged content failed eslint: $f (fix it, then git add again)" >&2
    exit 1
  fi
done
