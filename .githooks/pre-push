#!/usr/bin/env bash
# 重门：全仓 typecheck + vitest 全量（vitest 已含 fixture-boundary 与设计裸值/对比度/架构合规三
# checker——见 tests/unit/fixtures/boundary.test.ts 与 tests/unit/contract-gates.test.ts）。
# 验证对象=当前工作树（非被 push 的 commit 范围）——push 前保持工作树干净（commit 或 stash）；
# 并行会话留在工作树的 WIP 可能拦下本次 push（fail-closed、可见、可重试）。push 内容级校验与
# 全仓格式门（§12 钦定 pnpm exec prettier --check .）由 GitHub Actions CI（.github/workflows/ci.yml）负责。
# e2e 不进（NEXT_DIST_DIR=.next-e2e 独立构建过重，保持手动 pnpm test:e2e）。
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

pnpm typecheck
pnpm test
