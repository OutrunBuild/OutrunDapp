#!/usr/bin/env bash
# Heavy gates: repo-wide typecheck + full vitest (vitest already includes the fixture-boundary gate and
# the design bare-value/contrast/architecture-compliance/CJK-subset checkers -- see
# tests/unit/fixtures/boundary.test.ts and tests/unit/contract-gates.test.ts).
# Verified target = the current worktree (not the pushed commit range) -- keep the worktree clean before
# pushing (commit or stash); WIP left in the worktree by parallel sessions may block this push
# (fail-closed, visible, retryable). Content-level push validation and the repo-wide format gate
# (pnpm exec prettier --check .) are handled by GitHub Actions CI (.github/workflows/ci.yml).
# e2e is not included (the NEXT_DIST_DIR=.next-e2e standalone build is too heavy; keep manual pnpm test:e2e).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

pnpm typecheck
pnpm test
