# Outrun DApp local environment placeholders (one entry per supported testnet).
# Copy to .env.local and fill real values — .env.local is git-ignored (.gitignore: .env*.local).

# RPC primary (Alchemy) — one app per chain, domain-restricted keys
ALCHEMY_KEY_ARB_SEPOLIA=
ALCHEMY_KEY_BASE_SEPOLIA=
ALCHEMY_KEY_BSC_TESTNET=

# RPC fallback (Infura)
INFURA_KEY_ARB_SEPOLIA=
INFURA_KEY_BASE_SEPOLIA=
INFURA_KEY_BSC_TESTNET=

# Privy app id (public project id only — the app secret never enters the frontend).
# Copy to .env.local and fill the real value; without it the wallet layer rests at
# Disconnected (fixture mode, e2e).
NEXT_PUBLIC_PRIVY_APP_ID=

# Subgraph query endpoints (left empty until the subgraphs are deployed to The Graph Studio)
SUBGRAPH_ENDPOINT_ARB_SEPOLIA=
SUBGRAPH_ENDPOINT_BASE_SEPOLIA=
SUBGRAPH_ENDPOINT_BSC_TESTNET=
